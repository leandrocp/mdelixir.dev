{
  "name": "mdelixir.dev",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing website for MDEx - Fast Markdown for Elixir",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "lint": "oxlint api/ src/ test/ vite/",
    "fmt": "oxfmt api/ public/.well-known/ public/auth.md public/api.md public/openapi.json src/ test/ vercel.json vite/",
    "fmt:check": "oxfmt --check api/ public/.well-known/ public/auth.md public/api.md public/openapi.json src/ test/ vercel.json vite/"
  },
  "devDependencies": {
    "@lumis-sh/lumis": "^0.9.2",
    "@lumis-sh/themes": "^0.4.0",
    "@lumis-sh/vite": "^0.2.0",
    "@lumis-sh/wasm-bash": "^0.26.6",
    "@lumis-sh/wasm-comment": "^0.26.3",
    "@lumis-sh/wasm-css": "^0.26.4",
    "@lumis-sh/wasm-elixir": "^0.26.8",
    "@lumis-sh/wasm-html": "^0.26.4",
    "@lumis-sh/wasm-json": "^0.26.5",
    "@lumis-sh/wasm-markdown": "^0.26.3",
    "@lumis-sh/wasm-xml": "^0.26.4",
    "@tailwindcss/vite": "^4.3",
    "oxfmt": "^0.72",
    "oxlint": "^1.87",
    "tailwindcss": "^4.3",
    "tidewave": "^0.9",
    "vite": "^8.3"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
